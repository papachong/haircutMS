# ==============================================
# HaircutMS Production Environment Configuration
# ==============================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ==============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=haircutms
POSTGRES_PASSWORD=<change-me-to-a-strong-password>
POSTGRES_DB=haircutms

# ---------- Redis ----------
REDIS_PASSWORD=<change-me-to-a-strong-password>

# ---------- JWT Authentication ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=<generate-a-random-secret>
JWT_REFRESH_SECRET=<generate-a-random-secret>
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ---------- License ----------
# Encryption key for license validation
LICENSE_ENCRYPTION_KEY=<generate-a-32-byte-hex-key>

# ---------- Docker Image Tags ----------
# Used by docker-compose.prod.yml to pull the correct images
# For GHCR: ghcr.io/<owner>/haircutms/<image-name>:latest
SERVER_IMAGE=haircutms-server:latest
WEB_IMAGE=haircutms-web:latest

# ---------- Nginx ----------
# Override default ports if needed
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# ---------- Next.js ----------
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ---------- Deployment ----------
# Domain name for the application (used in health checks, CORS)
# APP_DOMAIN=your-domain.com
