# Test Environment Configuration
# Copy this file to .env.test and configure your values

# Database URL for testing (use separate test database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/haircut_ms_test

# JWT Secret for testing
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Platform Admin JWT Secret
PLATFORM_JWT_SECRET=test-platform-jwt-secret-key
PLATFORM_JWT_EXPIRES_IN=7d
PLATFORM_REFRESH_TOKEN_EXPIRES_IN=30d

# License Key Secret
LICENSE_SECRET=test-license-secret-key-for-testing-only

# API Configuration
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000